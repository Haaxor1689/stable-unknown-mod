{
  "$schema": "https://codeberg.org/ignitron/ignitron/raw/branch/master/Metadata.schema.json",
  "schema_version": 2,
  "assembly_relative_path": "stable_unknown_mod.dll",
  "id": "stable_unknown_mod",
  "display_name": "Stable Unknown",
  "description": "Prevents you from losing modded items/blocks if you load a world with missing mods.",
  "contributors": [
    {
      "name": "haaxor1689",
      "role": "author"
    }
  ],
  "version": "1.0.1",
  "dependencies": [
    {
      "id": "allumeria",
      "version": ">=0.15"
    },
    {
      "id": "aluminium",
      "version": ">=0.2.0"
    },
    {
      "id": "ignitron",
      "version": "0.8.*"
    },
    {
      "id": "harmony",
      "version": "2.*"
    }
  ],
  "environment": "client_server",
  "entrypoints": ["StableUnknown.Mod"]
}
